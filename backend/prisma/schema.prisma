generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  SECURITY_GUARD
  ADMIN
}

enum LostItemStatus {
  LOST
  FOUND
  RETURNED
}

enum TextbookCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole @default(STUDENT)
  studentNumber String?
  phone         String?
  createdAt     DateTime @default(now())

  studyGroupsOwned  StudyGroup[]        @relation("GroupOwner")
  studyGroupMembers StudyGroupMember[]
  lostItemsReported LostItem[]          @relation("ReportedBy")
  lostItemsHandled  LostItem[]          @relation("HandledBy")
  textbooksListed   Textbook[]
  eventRegistrations EventRegistration[]
  eventsCreated     CampusEvent[]       @relation("EventCreator")
}

model StudyGroup {
  id         String   @id @default(cuid())
  name       String
  module     String
  moduleCode String
  date       String
  time       String
  location   String
  maxMembers Int      @default(8)
  topics     String[]
  ownerId    String
  owner      User     @relation("GroupOwner", fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())

  members StudyGroupMember[]

  @@index([moduleCode])
}

model StudyGroupMember {
  id        String     @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime   @default(now())
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model LostItem {
  id          String         @id @default(cuid())
  name        String
  description String
  location    String
  dateLost    DateTime
  status      LostItemStatus @default(LOST)
  category    String
  image       String?
  reportedById String
  reportedBy   User          @relation("ReportedBy", fields: [reportedById], references: [id])
  handledById  String?
  handledBy    User?         @relation("HandledBy", fields: [handledById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

model Textbook {
  id          String            @id @default(cuid())
  title       String
  author      String
  module      String
  moduleCode  String
  price       Decimal           @db.Decimal(10, 2)
  condition   TextbookCondition
  image       String
  description String
  year        Int
  isbn        String?
  available   Boolean           @default(true)
  sellerId    String
  seller      User              @relation(fields: [sellerId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([moduleCode])
}

model CampusEvent {
  id          String   @id @default(cuid())
  title       String
  date        String
  time        String
  location    String
  category    String
  description String
  organiser   String
  capacity    Int
  image       String
  createdById String?
  createdBy   User?    @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  registrations EventRegistration[]
}

model EventRegistration {
  id           String      @id @default(cuid())
  eventId      String
  userId       String
  registeredAt DateTime    @default(now())
  event        CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
